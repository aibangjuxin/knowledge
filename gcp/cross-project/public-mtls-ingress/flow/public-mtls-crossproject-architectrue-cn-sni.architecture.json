        "Each Team location loads the same wildcard cert as Listenerset (option B)",
        "8K Agent syncs nginx.conf + certs (no Secret Manager / CSI Driver)"
      ]
    },
    {
      "dot": "rose",
      "title": "K8s Gateway + double-safeguard anti-drift",
      "items": [
        "Listenerset *.teamX.intra.domain matches Nginx-injected SNI",
