# 集群元信息模板 → 复制成 bootstrap/clusters/<cluster>/cluster.yaml
#
# ⚠️ 这份文件带 .example 后缀：
#    ApplicationSet 的 git 文件生成器只匹配 *.yaml，读不到它。
#
# ⚠️ cluster.yaml **不是 K8s 资源**，不会被 apply。
#    它是「集群事实来源」，供人阅读 + 供 validate-clusters.py 校验。
#    真正驱动 Application 生成的是同目录 components/*.yaml。

# ---- 以下 5 个字段：与 components/*.yaml 必须逐字一致 -------------------
cluster: dev-01                # 必须等于目录名
server: https://dev-01.k8s.example.com   # 必须与 Argo CD Cluster Secret 一致
env: dev                       # dev / stg / prod；必须等于集群名前缀
project: platform-dev          # AppProject 名，必须已在 bootstrap/appprojects/ 定义
namespace: platform-dev        # 组件默认落点

# ---- 以下字段：仅供人/工具参考，不参与 ApplicationSet 展开 ---------------
gcpProject: acme-platform-dev
gcpRegion: asia-east1
vpc: vpc-dev
argocdClusterSecret: dev-01    # argocd cluster add 生成的 Secret 名
workloadIdentityServiceAccount: sa-argocd@acme-platform-dev.iam.gserviceaccount.com
