{
  "name": "org-tag-name-convention",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["~ALL"],
      "exclude": ["sandbox-*"]
    },
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "tag_name_pattern",
      "parameters": {
        "name": "tag 必须是 v<major>.<minor>.<patch>[-预发布]",
        "negate": false,
        "operator": "regex",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"
      }
    }
  ]
}
