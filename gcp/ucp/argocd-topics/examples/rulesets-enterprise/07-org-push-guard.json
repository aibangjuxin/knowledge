{
  "name": "org-push-guard",
  "target": "push",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": ["~ALL"],
      "exclude": ["sandbox-*"]
    },
    "ref_name": {
      "include": ["~ALL"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          ".pem",
          ".key",
          ".p12",
          ".pfx",
          ".jks",
          ".keystore",
          ".ppk",
          ".asc",
          ".gpg",
          ".env"
        ]
      }
    },
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "releases/**",
          "**/*.tfstate",
          "**/*.tfstate.backup",
          "**/id_rsa*"
        ],
        "ignored_file_paths": []
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 10
      }
    },
    {
      "type": "block_credential_changes",
      "parameters": {
        "credential_types": ["password", "personal_access_token", "ssh_key"]
      }
    }
  ]
}
