{
  "name": "no-secrets-no-binaries",
  "target": "push",
  "enforcement": "active",
  "conditions": {},
  "rules": [
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": [
          ".pem",
          ".key",
          ".p12",
          ".pfx",
          ".jks",
          ".keystore",
          ".ppk"
        ]
      }
    },
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "releases/**",
          "**/*.tfstate",
          "**/*.tfstate.backup"
        ],
        "ignored_file_paths": []
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 10
      }
    }
  ]
}
