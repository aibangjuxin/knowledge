#!/usr/bin/env zsh
# launchwatch — LaunchAgents / LaunchDaemons 自启动项观察器 (合规与启动速度)
#
# 设计目标:
#   - 公司配 MacBook Pro,无 brew / 无 python,只 zsh + launchctl / plutil / cat
#   - 显示:
#       ① 用户级 LaunchAgents: ~/Library/LaunchAgents
#       ② 系统级 LaunchAgents: /Library/LaunchAgents (需要 sudo 才看得到 — 脚本可看但标 [?] 缺详情)
#       ③ 系统级 LaunchDaemons: /Library/LaunchDaemons
#       ④ macOS 自带 Daemons: /System/Library/LaunchDaemons
#       ⑤ 当前 launchd 正在跑的 jobs (status / PID / 上次退出码)
#       ⑥ Run on demand / KeepAlive / RunAtLoad 等关键 plist 字段
#   - 默认单次 (启动项变化慢,不需要高频刷新)
#
# 用法:
#   launchwatch                       # 单次全量
#   launchwatch --scope user          # 只看用户级
#   launchwatch --scope system        # 只看系统级
#   launchwatch --scope all           # 全看 (默认)
#   launchwatch --running             # 只看 launchctl 当前在跑的
#   launchwatch --label foo.bar       # 按 label 过滤
#   launchwatch --category login      # 按 category 过滤

emulate -L zsh
setopt errexit nounset pipefail extended_glob

typeset -r VERSION='1.0.0'
typeset -r SCRIPT_NAME=${0:t}
typeset SCOPE='all' RUNNING_ONLY=false
typeset LABEL_FILTER="" CATEGORY_FILTER=""

while (( $# > 0 )); do
  case $1 in
    --scope)      SCOPE=$2;        shift 2 ;;
    --running)    RUNNING_ONLY=true; shift ;;
    --label)      LABEL_FILTER=$2; shift 2 ;;
    --category)   CATEGORY_FILTER=$2; shift 2 ;;
    --version)    echo "$SCRIPT_NAME $VERSION"; exit 0 ;;
    --help|-h)
      echo "用法: $SCRIPT_NAME [--scope user|system|all] [--running] [--label PATTERN] [--category PATTERN]"
      exit 0
      ;;
    *) echo "$SCRIPT_NAME: 未知参数 $1" >&2; exit 1 ;;
  esac
done

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else
  C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_CYAN=''
fi

# 解析 plist,提取 6 个字段
# 输出 TSV: label <TAB> program <TAB> runatload <TAB> keepalive <TAB> user <TAB> category
#
# 两个 macOS 坑:
#   ① plutil -extract 对不存在的 key 返回 exit 1,errexit 下会杀掉整个脚本 — 必须 `|| echo ""`
#   ② KeepAlive 常常是 <dict> 而不是 <bool>,raw 模式会输出多行 — 必须压成单行
_parse_plist() {
  local plist=$1
  local label program runatload keepalive user category
  # 压成单行:dict 类型字段会带换行,会破坏 TSV
  local raw
  raw=$(plutil -extract Label raw -o - "$plist" 2>/dev/null) || raw=""
  label=${raw//$'\n'/ }
  raw=$(plutil -extract ProgramArguments.0 raw -o - "$plist" 2>/dev/null) \
    || raw=$(plutil -extract Program raw -o - "$plist" 2>/dev/null) || raw=""
  program=${raw//$'\n'/ }
  raw=$(plutil -extract RunAtLoad raw -o - "$plist" 2>/dev/null) || raw=""
  runatload=${raw//$'\n'/ }
  raw=$(plutil -extract KeepAlive raw -o - "$plist" 2>/dev/null) || raw=""
  keepalive=${raw//$'\n'/ }
  raw=$(plutil -extract UserName raw -o - "$plist" 2>/dev/null) || raw=""
  user=${raw//$'\n'/ }
  raw=$(plutil -extract LimitLoadToSessionType raw -o - "$plist" 2>/dev/null) || raw=""
  category=${raw//$'\n'/ }

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${label:-?}" "${program:-?}" "${runatload:-no}" "${keepalive:-no}" \
    "${user:-root}" "${category:-any}"
}

# 收集目录里所有 plist 的 label
# 关键: local 必须声明在 for 循环外面 — zsh 里循环体内重复 local 一个已有值的
# 变量,会把值回显到 stdout,污染管道输出
_collect() {
  local domain=$1   # user | system | daemon | apple
  local dir=$2
  local plist row lbl cat
  [[ -d $dir ]] || return
  # (.N) glob qualifier: 无匹配时返回空而不是报错
  for plist in "$dir"/*.plist(.N); do
    [[ -f $plist ]] || continue
    row=$(_parse_plist "$plist")
    [[ -z $row ]] && continue
    lbl=${row%%$'\t'*}
    if [[ -n $LABEL_FILTER ]] && [[ $lbl != *"$LABEL_FILTER"* ]]; then
      continue
    fi
    cat=${row##*$'\t'}
    if [[ -n $CATEGORY_FILTER ]] && [[ $cat != *"$CATEGORY_FILTER"* ]]; then
      continue
    fi
    printf '%s\t%s\n' "$domain" "$row"
  done
}

# launchctl 当前在跑的 jobs
# 输出: label<TAB>pid<TAB>last_exit
_running_jobs() {
  launchctl list 2>/dev/null | awk '
    NR > 1 {
      pid = $1; status = $2; label = $3
      if (pid == "-") pid = ""
      printf "%s\t%s\t%s\n", label, pid, status
    }
  '
}

# 渲染一个 plist 目录块
# 单独一个函数而不是内联三次:zsh 里同名 local 重复声明会把旧值回显到 stdout
_plist_block() {
  local title=$1 hint=$2 domain=$3 dir=$4 empty_msg=$5
  local data row lbl prg ral kal run_user cat color
  echo
  echo "${C_BOLD}  ${title}${C_RESET} ${C_DIM}(${hint})${C_RESET}"
  echo "  ${C_DIM}─────────────────────────────────────────────${C_RESET}"
  data=$(_collect "$domain" "$dir")
  if [[ -z $data ]]; then
    echo "  ${C_DIM}${empty_msg}${C_RESET}"
    return
  fi
  printf "  ${C_DIM}%-40s  %-25s  %-5s  %-16s  %-6s  %s${C_RESET}\n" \
    'LABEL' 'PROGRAM' 'RAL' 'KAL' 'USER' 'CATEGORY'
  while IFS=$'\t' read -r row; do
    row=${row#*$'\t'}   # 去掉第 1 列 domain
    IFS=$'\t' read -r lbl prg ral kal run_user cat <<< "$row"
    color=$C_GREEN
    [[ $ral == true ]] && color=$C_YELLOW   # 开机就跑,拖慢启动
    [[ $kal != no && -n $kal ]] && color=$C_RED   # KeepAlive = 常驻后台
    printf "  ${color}%-40s${C_RESET}  %-25s  %-5s  %-16s  %-6s  %s\n" \
      "${lbl:0:40}" "${prg##*/}" "$ral" "$kal" "$run_user" "$cat"
  done <<< "$data"
}

# ---- 渲染 ------------------------------------------------------------------
_render() {
  printf '\033[?25l\033[2J\033[H'

  echo "${C_BOLD}${C_CYAN}═══ LaunchAgents / Daemons 观察器 ═══${C_RESET}"
  echo "${C_DIM}本机器上的所有 launchd 自启动项 — 影响启动速度和合规审计${C_RESET}"
  [[ -n $LABEL_FILTER ]]  && echo "${C_DIM}过滤 label: ${LABEL_FILTER}${C_RESET}"
  [[ -n $CATEGORY_FILTER ]] && echo "${C_DIM}过滤 category: ${CATEGORY_FILTER}${C_RESET}"
  echo

  # ① 当前 launchctl 在跑的 jobs
  if $RUNNING_ONLY || [[ $SCOPE == all ]]; then
    echo "${C_BOLD}  当前 launchctl 在跑的 jobs${C_RESET} ${C_DIM}(launchctl list)${C_RESET}"
    echo "  ${C_DIM}─────────────────────────────────────────────${C_RESET}"
    local rj job_label job_pid job_exit
    rj=$(_running_jobs)
    if [[ -z $rj ]]; then
      echo "  ${C_DIM}(无 — 系统刚启动?)${C_RESET}"
    else
      printf "  ${C_DIM}%-8s  %-8s  %s${C_RESET}\n" 'PID' 'STATUS' 'LABEL'
      # head 会提前关掉管道导致上游 SIGPIPE(141),用 awk 截断避免
      print -r -- "$rj" | awk -v b=$C_BOLD -v r=$C_RESET 'NR<=30 {
        split($0, f, "\t")
        col = (f[3] ~ /^-/) ? "\033[31m" : (f[3] == "0" ? "\033[32m" : "\033[33m")
        pid = (f[2] == "") ? "-" : f[2]
        printf "  %-8s  %s%-8s%s  %s\n", pid, col, f[3], r, f[1]
      }'
      echo "  ${C_DIM}... 共 $(print -r -- "$rj" | wc -l | tr -d ' ') 个 jobs (只显示前 30)${C_RESET}"
    fi
  fi

  if $RUNNING_ONLY; then
    echo
    echo "${C_DIM}  $SCRIPT_NAME $VERSION · 数据源: launchctl list${C_RESET}"
    return
  fi

  # ②③④ 各目录 plist
  _plist_block '用户级 LaunchAgents' '~/Library/LaunchAgents' \
    'user' "$HOME/Library/LaunchAgents" '(无 — 公司电脑常见情况,IT 锁了用户级自启动)'
  _plist_block '系统级 LaunchAgents' '/Library/LaunchAgents' \
    'system' '/Library/LaunchAgents' '(无 — 公司电脑常见)'
  _plist_block '系统级 LaunchDaemons' '/Library/LaunchDaemons' \
    'daemon' '/Library/LaunchDaemons' '(无 — 第三方 Daemons,公司 Mac 通常被 MDM 锁)'

  # ⑤ macOS 自带 Daemons — 只统计,逐个列出来没意义
  echo
  echo "${C_BOLD}  macOS 自带 Daemons${C_RESET} ${C_DIM}(/System/Library/LaunchDaemons — 不要动)${C_RESET}"
  echo "  ${C_DIM}─────────────────────────────────────────────${C_RESET}"
  local apple apple_total apple_ral apple_kal
  apple=$(_collect 'apple' '/System/Library/LaunchDaemons')
  if [[ -z $apple ]]; then
    echo "  ${C_DIM}(目录不可读 — 罕见)${C_RESET}"
  else
    apple_total=$(print -r -- "$apple" | wc -l | tr -d ' ')
    # 统计前先剥掉 domain 列,字段才是 label..category
    apple_ral=$(print -r -- "$apple" | awk -F'\t' '{print $4}' | grep -c '^true$' || true)
    apple_kal=$(print -r -- "$apple" | awk -F'\t' '{print $5}' | grep -vc '^no$' || true)
    printf "  ${C_BOLD}%s${C_RESET} 个 daemon, ${C_BOLD}%s${C_RESET} RunAtLoad, ${C_BOLD}%s${C_RESET} KeepAlive\n" \
      "$apple_total" "$apple_ral" "$apple_kal"
    echo "  ${C_DIM}(用 --label <name> 查看具体某个)${C_RESET}"
  fi

  echo
  echo "${C_DIM}  $SCRIPT_NAME $VERSION · 数据源: plutil, launchctl list${C_RESET}"
  echo "${C_DIM}  RAL=RunAtLoad  KAL=KeepAlive  颜色:绿=一次性 / 黄=开机就跑 / 红=常驻后台${C_RESET}"
}

_cleanup() { printf '\033[?25h\033[0m'; echo; }
trap _cleanup EXIT INT TERM

_render
