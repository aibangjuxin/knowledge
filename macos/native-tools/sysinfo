#!/usr/bin/env zsh
# sysinfo — neofetch-style 系统总览,但 0 依赖,只跑 macOS 原生工具
#
# 设计目标:
#   - 公司配 MacBook Pro,ZSH only,无 brew / 无 jq / 无 python3 保证
#   - 输出格式与 neofetch 类似,但只用: sw_vers / sysctl / system_profiler / uname / uptime / vm_stat
#   - 单文件 ~100 行,执行 < 2s
#
# 用法:
#   sysinfo              # 默认 ASCII 横幅 + 信息列
#   sysinfo --compact    # 单列紧凑格式(适合 pipe)
#   sysinfo --json       # 原始键值对(给脚本消费,无装饰)
#
# 注意: heredoc 内 ANSI 转义用 \033[...m,echo 必须加 -e

emulate -L zsh
setopt errexit nounset pipefail

typeset -r VERSION='1.0.0'
typeset -r SCRIPT_NAME=${0:t}

# ---- 颜色 (TTY 检测) ------------------------------------------------------
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_MAGENTA=$'\033[35m'
  C_CYAN=$'\033[36m'
else
  C_RESET='' C_BOLD='' C_DIM=''
  C_RED='' C_GREEN='' C_YELLOW='' C_BLUE='' C_MAGENTA='' C_CYAN=''
fi

# ---- ASCII 横幅 -----------------------------------------------------------
typeset -ra ASCII_LOGO=(
"${C_CYAN}                    'c.          ${C_RESET}"
"${C_CYAN}                 ,xNMMx.          ${C_RESET}"
"${C_CYAN}               .OMMMMo.           ${C_RESET}"
"${C_CYAN}               OMMM0,              ${C_RESET}"
"${C_CYAN}     .;loddo:' loolloddol;.       ${C_RESET}"
"${C_CYAN}   cKMMMMMMMMMMNWMMMMMMMMMM0:     ${C_RESET}"
"${C_RED} .KMMMMMMMMMMMMMMMMMMMMMMMWd.    ${C_RESET}"
"${C_RED} xMMMMMMMMMMMMMMMMMMMMMMMMMXk;   ${C_RESET}"
"${C_RED}'MMMMMMMMMMMMMMMMMMMMMMMMMMMM:   ${C_RESET}"
"${C_RED} MMMMMMMMMMMMKMMMMMMMMMMMMMMMX.  ${C_RESET}"
"${C_YELLOW}.MMMMMMMMMMMMMMMMMMMMMMMMMMMMWk${C_RESET}"
"${C_YELLOW} xMMMMMMMMMMMMMMMMMMMMMMMMMMMMMx${C_RESET}"
"${C_YELLOW}  'MMMMMMMMMMMMMMMMMMMMMMMMMMMMM${C_RESET}"
"${C_GREEN}    'MMMMMMMMMMMMMMMMMMMMMMMMMMM${C_RESET}"
"${C_GREEN}     :MMMMMMMMMMMMMMMMMMMMMMMMM.${C_RESET}"
"${C_GREEN}      .MMMMMMMMMMMMMMMMMMMMMMMM${C_RESET}"
"${C_BLUE}       ;MMMMMMMMMMMMMMMMMMMMMMO${C_RESET}"
"${C_BLUE}        .MMMMMMMMMMMMMMMMMMMM:${C_RESET}"
"${C_BLUE}          ;MMMMMMMMMMMMMMMMM.${C_RESET}"
"${C_BLUE}            .cOMMMMMMMMMx..   ${C_RESET}"
)

# ---- 数据采集 (纯 zsh + 原生 binary) ---------------------------------------
# 缓存到变量,函数体内单次执行多次复用
typeset HW_MODEL HW_CHIP HW_CORES HW_MEM HW_SERIAL
typeset OS_NAME OS_VER OS_BUILD KERNEL
typeset HOST_NAME USER_NAME
typeset UPTIME LOAD1 LOAD5 LOAD15
typeset SHELL_PATH SHELL_VER
typeset CPU_BRAND CPU_SPEED

_hw_collect() {
  # system_profiler SPHardwareDataType 输出有多级缩进,用 awk 解析最稳
  local hw_data
  hw_data=$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': *' '
    /Model Name:/          { model = $2 }
    /Chip:/                { chip = $2 }
    /Total Number of Cores:/ { cores = $2 }
    /^[[:space:]]*Memory:/ { mem = $2 }
    END { printf "%s\t%s\t%s\t%s\n", model, chip, cores, mem }
  ')
  # 用 awk 拆分 TSV (避免 zsh (s:\t:) 在 ${} 嵌套里的诡异行为)
  HW_MODEL=$(awk -F'\t' '{print $1}' <<<"$hw_data")
  HW_CHIP=$(awk -F'\t' '{print $2}' <<<"$hw_data")
  HW_CORES=$(awk -F'\t' '{print $3}' <<<"$hw_data")
  HW_MEM=$(awk -F'\t' '{print $4}' <<<"$hw_data")

  OS_NAME=$(sw_vers -productName)
  OS_VER=$(sw_vers -productVersion)
  OS_BUILD=$(sw_vers -buildVersion)
  KERNEL=$(uname -r)
  HOST_NAME=$(scutil --get ComputerName 2>/dev/null || hostname -s)
  USER_NAME=${USER:-$(id -un)}

  # kern.boottime 格式: "{ sec = 1789002296, usec = 189147 } Thu Sep 10 ..."
  # 必须用非贪婪匹配,在第一个逗号停下
  local boot
  boot=$(sysctl -n kern.boottime | sed -nE 's/.*sec = ([0-9]+),.*/\1/p')
  [[ -z $boot ]] && boot=0
  local now up_s
  now=$(date +%s)
  up_s=$((now - boot))
  UPTIME=$(printf '%dd %dh %dm' $((up_s/86400)) $((up_s%86400/3600)) $((up_s%3600/60)))

  # vm.loadavg 格式: "{ 3.15 2.76 2.91 }"
  local la
  la=$(sysctl -n vm.loadavg | tr -d '{}')
  # 用 awk 拆分, 避免 zsh 嵌套参数扩展的坑
  LOAD1=$(awk '{print $1}' <<<"$la")
  LOAD5=$(awk '{print $2}' <<<"$la")
  LOAD15=$(awk '{print $3}' <<<"$la")

  SHELL_PATH=$SHELL
  if [[ -n $ZSH_VERSION ]]; then
    SHELL_VER="zsh $ZSH_VERSION"
  elif [[ -n $BASH_VERSION ]]; then
    SHELL_VER="bash $BASH_VERSION"
  else
    SHELL_VER=${SHELL:t}
  fi

  CPU_BRAND=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || sysctl -n hw.model)
  CPU_SPEED=$(sysctl -n hw.cpufrequency_max 2>/dev/null | awk '{printf "%.2f GHz", $0/1000000000}')
}

# ---- 渲染 ------------------------------------------------------------------
# 用双引号 (zsh printf 在单引号里不展开 ${VAR},而且 ${VAR} 在格式串里
# 还会被 zsh 当作 arith 求值触发 "bad math expression" 错)
_print_kv() {
  printf "  ${C_BOLD}%-14s${C_RESET} %s\n" "$1" "$2"
}

_print_pretty() {
  local -a lines=(
    "${C_CYAN}${USER_NAME}${C_RESET}${C_DIM}@${C_RESET}${C_CYAN}${HOST_NAME}${C_RESET}"
    "${C_DIM}──────────────────${C_RESET}"
    "OS${C_DIM}:${C_RESET}         ${OS_NAME} ${OS_VER} (${OS_BUILD})"
    "Host${C_DIM}:${C_RESET}       ${HW_MODEL}"
    "Chip${C_DIM}:${C_RESET}       ${HW_CHIP} (${HW_CORES})"
    "Memory${C_DIM}:${C_RESET}     ${HW_MEM}"
    "Kernel${C_DIM}:${C_RESET}     Darwin ${KERNEL}"
    "Shell${C_DIM}:${C_RESET}      ${SHELL_VER}"
    "Uptime${C_DIM}:${C_RESET}     ${UPTIME}"
    "Load${C_DIM}:${C_RESET}       ${LOAD1}, ${LOAD5}, ${LOAD15}"
  )
  # 横幅 + 信息列并排显示: 横幅固定 24 宽
  local logo_h=${#ASCII_LOGO}
  local info_h=${#lines}
  local max=$logo_h
  (( info_h > max )) && max=$info_h

  for (( i=0; i<max; i++ )); do
    local l=${ASCII_LOGO[$((i+1))]:-}
    local r=${lines[$((i+1))]:-}
    printf '%-30s %s\n' "${l}" "${r}"
  done
  echo
  printf "  ${C_DIM}采集命令:${C_RESET} sw_vers, system_profiler, sysctl, scutil, uname\n"
}

_print_compact() {
  printf 'OS=%s\n' "${OS_NAME} ${OS_VER} (${OS_BUILD})"
  printf 'Host=%s\n' "${HW_MODEL}"
  printf 'Chip=%s\n' "${HW_CHIP} (${HW_CORES})"
  printf 'Memory=%s\n' "${HW_MEM}"
  printf 'Kernel=Darwin %s\n' "${KERNEL}"
  printf 'Shell=%s\n' "${SHELL_VER}"
  printf 'Uptime=%s\n' "${UPTIME}"
  printf 'Load=%s %s %s\n' "${LOAD1}" "${LOAD5}" "${LOAD15}"
}

_print_json() {
  # 简单 k=v,确保可 jq 解析 (公司电脑可能没 jq,但格式兼容)
  cat <<EOF
{
  "user": "${USER_NAME}",
  "host": "${HOST_NAME}",
  "os": "${OS_NAME} ${OS_VER} (${OS_BUILD})",
  "kernel": "Darwin ${KERNEL}",
  "model": "${HW_MODEL}",
  "chip": "${HW_CHIP}",
  "cores": "${HW_CORES}",
  "memory": "${HW_MEM}",
  "shell": "${SHELL_VER}",
  "uptime": "${UPTIME}",
  "load_1m": "${LOAD1}",
  "load_5m": "${LOAD5}",
  "load_15m": "${LOAD15}"
}
EOF
}

# ---- 入口 ------------------------------------------------------------------
usage() {
  echo "用法: $SCRIPT_NAME [--compact|--json]"
  echo ""
  echo "  (无参数)    横幅 + 信息列(neofetch 风格)"
  echo "  --compact   单列紧凑格式,适合 pipe 给其他脚本"
  echo "  --json      输出可解析的 JSON"
  echo "  --version   显示版本"
  echo "  --help      本帮助"
}

main() {
  _hw_collect

  case "${1:-}" in
    ''|--pretty)  _print_pretty ;;
    --compact)    _print_compact ;;
    --json)       _print_json ;;
    --version)    echo "$SCRIPT_NAME $VERSION" ;;
    --help|-h)    usage ;;
    *)            usage; return 1 ;;
  esac
}

main "$@"